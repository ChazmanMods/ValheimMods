## Settings file generated by Runic Inventory 1.1.5.
## Keyboard shortcuts use MainKey + Modifier. Controller settings are Valheim ZInput action names.

[General]

## Automatically adds the equipment/quick-use row. Disable is unavailable until normal inventory has room for its items.
Enabled = true

[UI]

## Labels and a subtle outline appear only inside the open player inventory.
ShowRoleLabels = true
ShowInventoryStatus = false
ShowPickupPreview = true

## Collapse unused display space between Better Archery's quiver and Runic equipment row.
## Visual only: does not change inventory capacity, saved item positions, or keybindings.
CompactQuiverLayout = true

[Pickup Filter]

## Exact prefab IDs or shared-name tokens separated by comma, semicolon, or newline.
## Maximum 128 safe entries / 16,384 input characters. Quest items always bypass filtering.
Items =

[Sort]

## Zero-based general rows. Row 0 (hotbar) and the current bottom special row are rejected.
Rows = 1,2

[Keyboard]

## Primary lock gesture: hold Left Alt and right-click a player-inventory slot. This shortcut is an
## optional fallback for the currently focused slot.
## Locks exclude the cell from Runic Quick Stack (Alt+Q) only. Stacking, use, swaps, sorting,
## Store All, Restock, dropping, and processing remain available. Update RunicStorage to 1.2.5+.
UseQuickSlot1 = Alpha1 + LeftAlt
UseQuickSlot2 = Alpha2 + LeftAlt
UseQuickSlot3 = Alpha3 + LeftAlt
SortSelectedRows = I + LeftAlt
ToggleFocusedSlotLock = L + LeftAlt

[Controller]

## JoyMap is Valheim's layout-independent View/Back path. Holding ModifierAction prevents the
## accepted chord (and same-path aliases such as JoyChat) from also opening a vanilla panel.
## An existing file containing the exact untouched legacy controller set with JoyLBumper here is
## read as JoyMap in memory; the file is not rewritten. Any customized set remains literal.
Enabled = true
ModifierAction = JoyAltKeys
UseQuickSlot1Action = JoyMap
UseQuickSlot2Action = JoyButtonY
UseQuickSlot3Action = JoyRBumper
SortSelectedRowsAction = JoyButtonA
ToggleFocusedSlotLockAction = JoyButtonB

[Diagnostics]

## Successful protection decisions and control routes are logged when enabled. Indeterminate
## protection decisions always log once per bounded reason without item or player data.
Verbose = false
