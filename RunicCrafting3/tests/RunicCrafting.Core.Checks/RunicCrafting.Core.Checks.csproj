    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RunicCrafting.Core/RunicCrafting.Core.csproj" />
    <Compile Include="../../baseline/RunicCrafting/Domain/MaterialModels.cs" Link="Baseline/MaterialModels.cs" />
    <Compile Include="../../baseline/RunicCrafting/Domain/ExactMaterialPlanner.cs" Link="Baseline/ExactMaterialPlanner.cs" />
  </ItemGroup>
  <PropertyGroup><NoWarn>$(NoWarn);CS8625</NoWarn></PropertyGroup>
</Project>
