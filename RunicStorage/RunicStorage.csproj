<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RunicStorage</AssemblyName>
    <RootNamespace>RunicStorage</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">E:\SteamLibrary\steamapps\common\Valheim</VALHEIM_INSTALL>
    <GAME_MANAGED>$(VALHEIM_INSTALL)\valheim_Data\Managed</GAME_MANAGED>
    <BEPINEX_PROFILE Condition="'$(BEPINEX_PROFILE)' == ''">C:\Users\Charles Sammons\AppData\Roaming\r2modmanPlus-local\Valheim\profiles\Default\BepInEx</BEPINEX_PROFILE>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ModdedContainerCompatibility.cs" Link="Shared\ModdedContainerCompatibility.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Include="..\Shared\CaptionBend.cs" Link="Shared\CaptionBend.cs" />
    <Compile Include="..\Shared\CaptionCurve.cs" Link="Shared\CaptionCurve.cs" />
    <Compile Include="..\Shared\CaptionMeshCurve.cs" Link="Shared\CaptionMeshCurve.cs" />
    <None Remove="Tests\**\*" />
    <Compile Include="..\Shared\Emoji\*.cs" Link="Shared\Emoji\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Shared\Emoji\atlas.png" LogicalName="Runic.Emoji.atlas.png" />
    <EmbeddedResource Include="..\Shared\Emoji\LICENSE-GRAPHICS.txt" LogicalName="Runic.Emoji.LICENSE.txt" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GAME_MANAGED)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ModalGameplayInput.cs" Link="Shared\ModalGameplayInput.cs" />
    <Compile Include="..\RunicCore\Api\RunicIdentifier.cs" Link="Shared\RunicIdentifier.cs" />
    <Compile Include="..\RunicCore\Api\Keybindings.cs" Link="Shared\Keybindings.cs" />
    <Reference Include="BepInEx" HintPath="$(BEPINEX_PROFILE)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BEPINEX_PROFILE)\core\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(GAME_MANAGED)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(GAME_MANAGED)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(GAME_MANAGED)\assembly_guiutils.dll" Private="false" />
    <Reference Include="gui_framework" HintPath="$(GAME_MANAGED)\gui_framework.dll" Private="false" />
    <Reference Include="System.Net.Http" HintPath="$(GAME_MANAGED)\System.Net.Http.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GAME_MANAGED)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GAME_MANAGED)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GAME_MANAGED)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GAME_MANAGED)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GAME_MANAGED)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GAME_MANAGED)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GAME_MANAGED)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GAME_MANAGED)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GAME_MANAGED)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\Shared\InventorySafety\*.cs" Link="InventorySafety\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Translations/RunicStorage/English.json" LogicalName="Runic.Localization.English.json" />
    <None Update="Translations/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
