## Settings file generated by plugin Runic Agriculture v1.0.0
## Plugin GUID: chazman.RunicAgriculture

[General]

Enabled = true

[Planting Pattern]

Pattern = Grid
Alignment = PlayerHeading
Rows = 5
ColumnsOrPoints = 5
SpacingMeters = 1.5
# Legacy migration-only value. Live Circle size uses Rows and Columns.
CircleRadiusMeters = 3
MirrorShape = false
TrapezoidLeftPinch = 0.5
TrapezoidRightPinch = 0.5

[Planting Resources]

# Player-centered search range. Personal inventory is consumed before eligible nearby chests.
# Chests must be static, locally owned, unused, accessible, ward-permitted, and synchronized.
NearbyChestRangeMeters = 30

[Migrations]

LegacyCircleRadiusMappedToRowsAndColumns = true
# One-time reset from a previously saved shape to Grid and selection of the native HUD scale.
GridAndCompactBottomHudApplied = true

[Confirmation]

InvalidPositionPolicy = SkipInvalid
ResourceShortfallPolicy = TruncatePredictably

[Harvest]

RadiusMeters = 4
MaximumPlants = 25
OfferConfirmedReplant = true

[Status]

ShowBeeAndCropStatus = true
ShowContextualControls = true
ControlBarScale = 0.9

[Diagnostics]

VerboseLogging = false

[Controls]

# Planting uses ordinary left click while a valid cultivator pattern preview is active.
ConfirmPattern = Mouse0
CyclePattern = O + LeftAlt
AreaHarvestModifierInteract = E + LeftAlt
ConfirmReplant = T + LeftAlt

[Pattern Editing Controls]

IncreaseRows = UpArrow + LeftAlt + LeftShift
DecreaseRows = DownArrow + LeftAlt + LeftShift
IncreaseColumns = RightArrow + LeftAlt + LeftShift
DecreaseColumns = LeftArrow + LeftAlt + LeftShift
ToggleShapeSide = L + LeftAlt + LeftShift
DecreaseLeftTrapezoidPinch = LeftBracket + LeftAlt + LeftShift
IncreaseLeftTrapezoidPinch = RightBracket + LeftAlt + LeftShift
DecreaseRightTrapezoidPinch = Semicolon + LeftAlt + LeftShift
IncreaseRightTrapezoidPinch = Quote + LeftAlt + LeftShift

[Controller Controls]

Enabled = true
ModifierAction = JoyAltKeys
ConfirmAction = JoyPlace
CyclePatternAction = JoyPrevSnap
AreaHarvestAction = JoyUse

[Controller Pattern Editor]

PreviousEditorFieldAction = JoyDPadUp
NextEditorFieldAction = JoyDPadDown
DecreaseEditorValueAction = JoyDPadLeft
IncreaseEditorValueAction = JoyDPadRight
