<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.9.18</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ArcaneNaturalWaters</AssemblyName>
    <RootNamespace>ArcaneWaterWorks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">E:\SteamLibrary\steamapps\common\Valheim</VALHEIM_INSTALL>
    <GAME_MANAGED>$(VALHEIM_INSTALL)\valheim_Data\Managed</GAME_MANAGED>
    <BEPINEX_PROFILE Condition="'$(BEPINEX_PROFILE)' == ''">C:\Users\Charles Sammons\AppData\Roaming\r2modmanPlus-local\Valheim\profiles\Solo\BepInEx</BEPINEX_PROFILE>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.UIModule" HintPath="$(GAME_MANAGED)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GAME_MANAGED)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GAME_MANAGED)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(GAME_MANAGED)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" HintPath="$(GAME_MANAGED)\UnityEngine.UnityWebRequestAudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GAME_MANAGED)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GAME_MANAGED)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BEPINEX_PROFILE)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BEPINEX_PROFILE)\core\0Harmony.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="$(BEPINEX_PROFILE)\plugins\ValheimModding-Jotunn\Jotunn.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(GAME_MANAGED)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(GAME_MANAGED)\assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GAME_MANAGED)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(GAME_MANAGED)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GAME_MANAGED)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GAME_MANAGED)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GAME_MANAGED)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GAME_MANAGED)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(GAME_MANAGED)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GAME_MANAGED)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GAME_MANAGED)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GAME_MANAGED)\Unity.TextMeshPro.dll" Private="false" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Diagnostics/**/*.cs" />
    <Compile Remove="ShaderProject/**/*.cs" />
    <Compile Remove="ShaderProject2022/**/*.cs" />
    <EmbeddedResource Include="Assets/riverflow" LogicalName="ArcaneWaterWorks.RiverFlow" />
    <EmbeddedResource Include="Assets/mid-size-river.wav" LogicalName="ArcaneWaterWorks.MidSize" />
    <EmbeddedResource Include="icon.png" LogicalName="ArcaneWaterWorks.Icon" />
    <EmbeddedResource Include="Assets/brook.wav" LogicalName="ArcaneWaterWorks.Brook" />
    <EmbeddedResource Include="Assets/large-river.wav" LogicalName="ArcaneWaterWorks.Large" />
    <EmbeddedResource Include="Assets/HotSprings/*.ogg;Assets/HotSprings/*.mp3" LogicalName="ArcaneWaterWorks.HotSprings.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Pools/*.wav" LogicalName="ArcaneNaturalWaters.Pools.Audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Pools/*.meshbin;Assets/Pools/*.jpg;Assets/Pools/*.png" LogicalName="ArcaneNaturalWaters.Pools.Models.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Pools/cascade" LogicalName="ArcaneNaturalWaters.Pools.Cascade" />
    <EmbeddedResource Include="Assets/BuildIcons/*.png" LogicalName="ArcaneWaterWorks.BuildIcons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>



